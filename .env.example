# ==============================================================================
# SentinelX Platform Configuration Template
# Copy this file to .env and customize for local environment
# In production (APP_ENV=production), missing PostgreSQL or default secrets fail closed.
# ==============================================================================

# Application Environment: development | production | test
APP_ENV=development

# Database Connection URL:
# Development / Local fallback (SQLite Async):
DATABASE_URL=sqlite+aiosqlite:///./sentinelx_dev.db
# Production (PostgreSQL 16 Async in Docker):
# DATABASE_URL=postgresql+asyncpg://sentinelx_user:sentinelx_secure_pass@postgres:5432/sentinelx

# Authentication & JWT Security:
# CHANGE THIS IN PRODUCTION! Minimum 32 characters.
JWT_SECRET=dev_jwt_secret_key_change_in_prod_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# Telemetry Ingestion API Key (default demo key seeded by scripts/seed_db.py):
INGEST_API_KEY=sen_ingest_demo_key

# Perimeter & Cross-Origin Resource Sharing (comma-separated):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8000

# Optional Outbound Response Webhook URL (for Incident Notification Sink):
NOTIFICATION_WEBHOOK_URL=

# Logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

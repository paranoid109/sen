{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sentinelx.io/schemas/alert_contract.json",
  "title": "SentinelX Alert Contract",
  "description": "Curated security alert generated by Detection Engine (M4) and managed by Alert Service (M5)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "alert_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique UUIDv4 identifier of the alert"
    },
    "rule_id": {
      "type": "string",
      "description": "Identifier of the triggered detection rule (e.g. RULE-AUTH-001)"
    },
    "rule_name": {
      "type": "string",
      "description": "Human-readable detection rule name"
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"],
      "description": "Alert severity rating"
    },
    "status": {
      "type": "string",
      "enum": ["NEW", "INVESTIGATING", "RESOLVED", "FALSE_POSITIVE"],
      "description": "Alert triage state"
    },
    "mitre_attack_id": {
      "type": ["string", "null"],
      "description": "MITRE ATT&CK technique ID (e.g. T1110)"
    },
    "source_ip": {
      "type": "string",
      "description": "Attacker/source IP address"
    },
    "target_asset_id": {
      "type": ["string", "null"],
      "description": "UUID of the victim/monitored CMDB asset"
    },
    "target_host": {
      "type": ["string", "null"],
      "description": "Victim hostname or IP identifier"
    },
    "dedup_key": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "description": "SHA-256 deduplication hash (sha256(rule_id:asset:source_ip))"
    },
    "occurrence_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Total number of aggregated event occurrences under this alert"
    },
    "first_seen": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp of the earliest event matching this alert"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp of the most recent event matching this alert"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "description": "List of supporting event UUIDs (capped at 100)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC creation timestamp"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC last updated timestamp"
    }
  },
  "required": [
    "alert_id",
    "rule_id",
    "rule_name",
    "severity",
    "status",
    "source_ip",
    "dedup_key",
    "occurrence_count",
    "first_seen",
    "last_seen",
    "created_at",
    "updated_at"
  ]
}
